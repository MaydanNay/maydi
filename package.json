{
  "name": "maydi_promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "vite build",
    "build:studio": "npm --prefix maydi_studio run build",
    "build:all": "vite build && npm run build:studio && rm -rf dist/studio && mkdir -p dist/studio && cp -a maydi_studio/dist/. dist/studio/",
    "lint": "oxlint src",
    "test": "vitest run",
    "preview": "vite preview --port 4180 --strictPort --host"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "postprocessing": "^6.39.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
